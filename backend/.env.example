# ── Groq (free-tier LLM) ──────────────────────────────────────────────────────
# Copy this file to .env and fill in your key.
# Leave GROQ_API_KEY blank to run in offline / rule-based mode (all tests pass).

# Get a free API key at https://console.groq.com
GROQ_API_KEY=

# Model to use (default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# ── IBM watsonx Orchestrate agent (optional; the app uses the rules without it) ──
# From the Orchestrate console: user icon > Settings > API details.
ORCHESTRATE_INSTANCE_URL=
ORCHESTRATE_API_KEY=
# From `orchestrate agents list -k native` (ID column) after importing the agent.
ORCHESTRATE_AGENT_ID=
# Optional: ibm_iam, mcsp, mcsp_v1 or mcsp_v2 (same as `orchestrate env add --type`).
# Leave empty to infer it like the ADK: *.cloud.ibm.com hosts use IBM Cloud IAM; other
# hosts (e.g. api.<region>.dl.watson-orchestrate.ibm.com) use MCSP v1/v2 by key type.
ORCHESTRATE_AUTH_TYPE=
# Optional token service base URL (like the ADK's --iam-url); empty uses the default.
ORCHESTRATE_IAM_URL=

# Optional: comma-separated origins allowed to call the API directly from a browser (CORS).
# Not needed for the Vite dev server or a tunnel to it (they proxy /api). Default: the local
# Vite dev server. "*" is ignored.
CORS_ALLOWED_ORIGINS=

# ORCHESTRATE_INSTANCE_URL and ORCHESTRATE_IAM_URL must be https:// URLs; otherwise the agent
# stays off and the app uses the built-in rules.
