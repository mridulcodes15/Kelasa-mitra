# ── Groq (free-tier LLM) ──────────────────────────────────────────────────────
# Copy this file to .env and fill in your key.
# Leave GROQ_API_KEY blank to run in offline / rule-based mode (all tests pass).

# Get a free API key at https://console.groq.com
GROQ_API_KEY=

# Model to use (default: llama-3.3-70b-versatile — best Indic language support on free tier)
GROQ_MODEL=llama-3.3-70b-versatile
